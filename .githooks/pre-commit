#!/usr/bin/env bash
# The gate is bl-gate (userconf); see AGENTS.md "The gate". Ahead of it, one
# refusal about the REF and not the tree, so no verdict can carry it: no
# direct commit to mainline. A squash landing from `bl close` is the tail of
# a merge (MERGE_MSG/SQUASH_MSG present) and passes.
set -euo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)"
git_dir="$(git rev-parse --git-dir)"
case "$branch" in
  main|master)
    if [ ! -f "$git_dir/MERGE_MSG" ] && [ ! -f "$git_dir/SQUASH_MSG" ]; then
      echo "error: direct commits to '$branch' are not permitted." >&2
      echo "       use 'bl claim <task>' to work in a worktree, then 'bl close'." >&2
      exit 1
    fi
    ;;
esac

exec bl-gate "$@"
