#!/usr/bin/env bash
# Litany pre-commit hook.
#
# Enforces:
#   1. No direct commits to mainline (main/master). Squash-merges from `bl review`
#      are permitted; detected via presence of MERGE_MSG or SQUASH_MSG.
#   2. No source file over 300 lines (docs and config exempt).
#   3. `make check` — the repo's gate: fmt-check, clippy (-D warnings),
#      100% coverage (cargo tarpaulin --fail-under 100), and the install
#      contract (cargo test --test install, uninstrumented — tarpaulin skips
#      it). The Makefile is the single source of what the gate is; this hook
#      invokes `make check`
#      rather than re-listing the commands, so the close gate can never drift
#      from `make check`. rust-toolchain.toml pins the toolchain, so the
#      fmt/clippy verdict is identical here, in CI, and for every agent.
#
# Bypass is intentionally not supported. If something is broken, fix it.

set -euo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)"
git_dir="$(git rev-parse --git-dir)"

case "$branch" in
  main|master)
    if [ ! -f "$git_dir/MERGE_MSG" ] && [ ! -f "$git_dir/SQUASH_MSG" ]; then
      echo "error: direct commits to '$branch' are not permitted." >&2
      echo "       use 'bl claim <task>' to work in a worktree, then 'bl review'." >&2
      exit 1
    fi
    ;;
esac

# The 300-line cap is a repo INVARIANT, not a per-commit property: a file
# can cross the cap in one commit and never be re-measured if we only look
# at the staged set. So sweep every tracked code file in the whole tree
# (git ls-files is cheap — a single index read, no working-tree walk).
exempt='\.(md|txt|toml|yaml|yml|json|lock)$|(^|/)(Makefile|LICENSE|\.gitignore|\.githooks/)'
while IFS= read -r file; do
  [ -z "$file" ] && continue
  [[ "$file" =~ $exempt ]] && continue
  [ -f "$file" ] || continue
  lines=$(wc -l < "$file")
  if [ "$lines" -gt 300 ]; then
    echo "error: $file has $lines lines (>300 limit for code files)." >&2
    exit 1
  fi
done < <(git ls-files)

if [ -f Cargo.toml ] && command -v make >/dev/null 2>&1 && command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: running 'make check' (fmt-check, clippy -D warnings, 100% coverage, install contract)..." >&2
  make check
fi
