.claude

# Added by cargo

/target
lcov.info

# The cross-produced macOS artifacts (`make mac-artifact`). Build output, not
# source: reproducible from `Containerfile.mac`, and they belong in a release
# rather than in the tree.
/dist

# Gate-run scratch at the repo root. `cargo tarpaulin` drops the build
# script's `build_rs_cov.profraw` here, and agents commonly tee `make check`
# into check.log / its status into check.exit. This has to be ignored rather
# than merely cleaned up: `bl close` stages every untracked file in the
# worktree, so unignored debris rides onto main (check.exit did, in 6cf98c1).
*.profraw
check.log
check.exit
